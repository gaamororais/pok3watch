{
  "manifest_version": 3,
  "name": "Pok3Watch — Monitor de Capturas",
  "version": "1.53",
  "description": "Monitor passivo de capturas, shinies, drops, Pokébolas e conexão para Poke Idle World com resumo periódico.",
  "permissions": [
    "storage",
    "power",
    "tabs",
    "notifications",
    "alarms",
    "sidePanel"
  ],
  "host_permissions": [
    "https://poke.idleworld.online/*",
    "https://api.callmebot.com/*",
    "https://piwtools.com.br/*"
  ],
  "background": {
    "service_worker": "background.js"
  },
  "content_scripts": [
    {
      "matches": [
        "https://poke.idleworld.online/*"
      ],
      "css": [
        "hud.css"
      ],
      "js": [
        "idiomas.js",
        "firstcatch.js",
        "hunts.js",
        "cerebro.js",
        "content.js"
      ],
      "run_at": "document_idle"
    },
    {
      "matches": [
        "https://piwtools.com.br/*"
      ],
      "js": [
        "piwtools-autofill.js"
      ],
      "run_at": "document_idle"
    }
  ],
  "icons": {
    "16": "icons/icon16.png",
    "32": "icons/icon32.png",
    "48": "icons/icon48.png",
    "128": "icons/icon128.png"
  },
  "action": {
    "default_popup": "popup.html",
    "default_title": "Pok3Watch — Configurações",
    "default_icon": {
      "16": "icons/icon16.png",
      "32": "icons/icon32.png",
      "48": "icons/icon48.png",
      "128": "icons/icon128.png"
    }
  },
  "side_panel": {
    "default_path": "popup.html?painel=1"
  },
  "minimum_chrome_version": "114"
}
